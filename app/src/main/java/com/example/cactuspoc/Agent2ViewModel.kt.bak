// ─────────────────────────────────────────────────────────────────────────────
// IN-MEMORY VECTOR DB
// ─────────────────────────────────────────────────────────────────────────────

class InMemoryVectorDB {
    private val entries = mutableListOf<VectorEntry>()

    fun add(entry: VectorEntry) = entries.add(entry)

    fun search(
        queryEmbedding: List<Double>,
        topK: Int = 3,
        excludeId: String,
        // Optional: boost items that share the same contact
        contactBoost: String? = null
    ): List<Pair<VectorEntry, Double>> {
        return entries
            .filter { it.item.id != excludeId }
            .map { entry ->
                var score = cosineSimilarity(queryEmbedding, entry.embedding)
                // Small boost for same-contact matches so Sarah↔Sarah
                // and David↔David surface more reliably
                if (contactBoost != null && entry.item.contactName == contactBoost) {
                    score = (score + 0.08).coerceAtMost(1.0)
                }
                entry to score
            }
            .sortedByDescending { it.second }
            .take(topK)
    }

    private fun cosineSimilarity(a: List<Double>, b: List<Double>): Double {
        if (a.size != b.size) return 0.0
        var dot = 0.0; var normA = 0.0; var normB = 0.0
        for (i in a.indices) { dot += a[i] * b[i]; normA += a[i] * a[i]; normB += b[i] * b[i] }
        val denom = sqrt(normA) * sqrt(normB)
        return if (denom == 0.0) 0.0 else dot / denom
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// VIEW MODEL
// ─────────────────────────────────────────────────────────────────────────────

class Agent2ViewModel : ViewModel() {

    private val lm = CactusLM()
    private val vectorDB = InMemoryVectorDB()

    private val _state = MutableStateFlow<DemoState>(DemoState.Idle)
    val state: StateFlow<DemoState> = _state

    companion object {
        // Lowered slightly since qwen3-0.6 embeddings cluster in a narrow range.
        // Contact boost compensates for semantic drift between same-person items.
        const val SIMILARITY_THRESHOLD = 0.55
        const val MODEL_SLUG = "qwen3-0.6"
//        const val MODEL_SLUG = "qwen3-1.7"
    }

    fun listAvailableModels() {
        viewModelScope.launch {
            try {
                val models = lm.getModels()

//                if (models == null) {
//                    println("Model list is null")
//                    return@launch
//                }

//                println("──────── AVAILABLE CACTUS MODELS ────────")
//
//                models.forEach { model ->
//                    println("Model: ${model.slug}")
////                    println("  size: ${model.sizeBytes}")
//                    println("  downloaded: ${model.isDownloaded}")
////                    println("  embedding: ${model.supportsEmbeddings}")
////                    println("  completion: ${model.supportsCompletion}")
//                    println("------------------------------------------")
//                }
                print(models)

            } catch (e: Exception) {
                println("Error listing models: ${e.message}")
            }
        }
    }

    fun runDemo() {
        viewModelScope.launch {
            val log = mutableListOf<String>()
            fun emit(line: String) {
                log.add(line)
                _state.value = DemoState.Processing(log.toList())
            }

            try {
                _state.value = DemoState.Loading("Downloading $MODEL_SLUG…")
                listAvailableModels()

                val lm = CactusLM()



                // Get list of available models

                val models = lm.getModels()



                models.forEach { model ->

                    println("Model: ${model.name}")

                    println("  Slug: ${model.slug}")

                    println("  Size: ${model.size_mb} MB")

                    println("  Tool calling: ${model.supports_tool_calling}")

                    println("  Vision: ${model.supports_vision}")

                    println("  Downloaded: ${model.isDownloaded}")

                }

                lm.downloadModel(MODEL_SLUG)
                lm.initializeModel(CactusInitParams(model = MODEL_SLUG, contextSize = 2048))
                emit("✅ Model ready: $MODEL_SLUG\n")

                val proposedActions = mutableListOf<ProposedAction>()

                for (item in syntheticItems) {
                    emit("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
                    emit("▶ [${item.id}] ${item.type}  •  ${item.contactName} (${item.contactGroup})")
                    emit("  \"${item.text}\"")
                    emit("  Tags: ${item.tags.joinToString()}")

                    // ── Embed an enriched string, not just item.text ──────────
                    // Packing contact + group + type + tags into the embedded text
                    // gives the small model much more signal to differentiate items.
                    val enrichedText = buildEmbedText(item)
                    emit("  📝 Embedding: \"$enrichedText\"")

                    val embResult = lm.generateEmbedding(text = enrichedText)
                    if (embResult == null || !embResult.success) {
                        emit("  ⚠ Embedding failed: ${embResult?.errorMessage ?: "null"}\n")
                        continue
                    }
                    emit("  📐 Embedded  dim=${embResult.dimension}")

                    vectorDB.add(VectorEntry(item, embResult.embeddings))
                    emit("  💾 Stored in vector DB  (contact=${item.contactName}, group=${item.contactGroup}, type=${item.type})")

                    // ── Search with contact boost ─────────────────────────────
                    val matches = vectorDB.search(
                        queryEmbedding = embResult.embeddings,
                        topK = 3,
                        excludeId = item.id,
                        contactBoost = item.contactName
                    )
                    val goodMatches = matches.filter { it.second >= SIMILARITY_THRESHOLD }

                    if (goodMatches.isEmpty()) {
                        val best = matches.firstOrNull()?.second?.let { "%.3f".format(it) } ?: "—"
                        emit("  🔍 No strong matches yet  (best score=$best)\n")
                        continue
                    }

                    emit("  🔍 ${goodMatches.size} match(es) ≥ $SIMILARITY_THRESHOLD:")
                    goodMatches.forEach { (entry, score) ->
                        emit("     [${entry.item.id}] ${"%.3f".format(score)}  ${entry.item.contactName} (${entry.item.contactGroup})  \"${entry.item.text}\"")
                    }

                    emit("  🤔 Reasoning with LLM…")
                    val (bestEntry, bestScore) = goodMatches.first()
                    val action = reasonAndDecide(item, bestEntry.item, bestScore)
                    proposedActions.add(action)

                    emit("  ✅ ${action.actionType}")
                    emit("  💬 \"${action.notificationMessage}\"\n")
                }

                emit("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
                emit("📋 PROPOSED ACTIONS SUMMARY  (${proposedActions.size} total)")
                emit("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
                proposedActions.forEachIndexed { i, a ->
                    emit("")
                    emit("  [${i + 1}] ${a.actionType}")
                    emit("      Trigger : [${a.triggerItem.id}] ${a.triggerItem.contactName}  \"${a.triggerItem.text}\"")
                    emit("      Match   : [${a.matchedItem.id}] ${a.matchedItem.contactName}  \"${a.matchedItem.text}\"")
                    emit("      Score   : ${"%.3f".format(a.similarity)}")
                    emit("      Why     : ${a.reasoning}")
                    emit("      Notif   : \"${a.notificationMessage}\"")
                }

                _state.value = DemoState.Done(log.toList(), proposedActions)

            } catch (e: Exception) {
                _state.value = DemoState.Error(e.message ?: "Unknown error")
            } finally {
                lm.unload()
            }
        }
    }

    /**
     * Build an enriched string for embedding.
     * Including contact name, group, type and tags gives the small model
     * much more signal — especially for cross-type matches like
     * contextual-Sarah ↔ actionable-Sarah.
     */
    private fun buildEmbedText(item: AgentItem): String {
        return "[${item.type}] [${item.contactGroup}] contact:${item.contactName} " +
                "tags:${item.tags.joinToString(",")} | ${item.text}"
    }

    private suspend fun reasonAndDecide(
        newItem: AgentItem,
        matchedItem: AgentItem,
        similarity: Double
    ): ProposedAction {
        val prompt = """
You are the reasoning core of a proactive personal assistant.
Two related pieces of information about the user's life have been found.

NEW ITEM  [${newItem.id}]
Type    : ${newItem.type}
Contact : ${newItem.contactName} (${newItem.contactGroup})
Tags    : ${newItem.tags.joinToString()}
Content : "${newItem.text}"

RELATED ITEM  [${matchedItem.id}]
Type    : ${matchedItem.type}
Contact : ${matchedItem.contactName} (${matchedItem.contactGroup})
Tags    : ${matchedItem.tags.joinToString()}
Content : "${matchedItem.text}"

Similarity score: ${"%.2f".format(similarity)}

Your task:
1. Explain in 1-2 sentences WHY these are related and what tension or opportunity they create.
2. Choose the single most appropriate action using these rules:
   - NOTIFY_CLASH   → two events have a direct time or scheduling conflict
   - SUGGEST_PREP   → contextual info (preference, feedback, status) is directly relevant to an upcoming event or task
   - SEND_REMINDER  → a task or commitment risks being forgotten given new context
   - SET_ALARM      → there is a hard, time-sensitive deadline that needs a reminder alarm
3. Write a short, friendly push notification (max 20 words) the user will actually see on their phone.

Reply in EXACTLY this format with no extra text:
REASONING: <1-2 sentences>
ACTION: <action>
MESSAGE: <notification text>
""".trimIndent()

        val result = lm.generateCompletion(
            messages = listOf(
                ChatMessage(role = "system", content = "You are a concise personal assistant. Follow the output format exactly. Never add extra text outside the three fields."),
                ChatMessage(role = "user", content = prompt)
            ),
            params = CactusCompletionParams(maxTokens = 180, temperature = 0.5)
        )

        val response = if (result?.success == true) result.response?.trim() ?: "" else ""
        return ProposedAction(
            triggerItem = newItem,
            matchedItem = matchedItem,
            similarity = similarity,
            reasoning  = extractField(response, "REASONING") ?: "Items are related.",
            actionType = extractField(response, "ACTION")    ?: "SEND_REMINDER",
            notificationMessage = extractField(response, "MESSAGE") ?: "You have related items needing attention."
        )
    }

    private fun extractField(text: String, field: String): String? =
        text.lines()
            .firstOrNull { it.startsWith("$field:") }
            ?.removePrefix("$field:")?.trim()
            ?.takeIf { it.isNotBlank() }

    override fun onCleared() {
        super.onCleared()
        lm.unload()
    }
}